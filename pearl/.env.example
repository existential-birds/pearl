# Pearl Environment Configuration Example
# Copy this file to .env and fill in your actual values

# ============================================================
# Phoenix Configuration
# ============================================================

# Server port (default: 4000)
PORT=4000

# Enable Phoenix server (useful for releases)
# PHX_SERVER=true

# ============================================================
# LLM Provider Configuration
# ============================================================

# Primary LLM provider (options: ollama | openrouter | claude-code)
# Default: openrouter
LLM_PROVIDER=openrouter

# Model to use with the LLM provider (pass-through to provider)
# Examples:
#   OpenRouter: openai/gpt-5.2, anthropic/claude-3.5-sonnet
#   Ollama: llama3.2:3b, mistral
#   Claude Code: claude-sonnet-4-5-20250929
LLM_MODEL=openai/gpt-5.2

# ============================================================
# Embedding Provider Configuration
# ============================================================

# Embedding provider (options: ollama | openrouter | openai)
# If not set, defaults to LLM_PROVIDER value
# EMBEDDING_PROVIDER=openrouter

# Model for generating embeddings
# Examples:
#   OpenRouter/OpenAI: openai/text-embedding-3-small
#   Ollama: rjmalagon/gte-qwen2-1.5b-instruct-embed-f16
EMBEDDING_MODEL=openai/text-embedding-3-small

# ============================================================
# API Keys
# ============================================================

# Anthropic API key (required for claude-code provider)
# Get your key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key (required for openai embedding provider)
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# OpenRouter API key (required for openrouter provider)
# Get your key from: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# ============================================================
# Provider-Specific Configuration
# ============================================================

# OpenRouter default model (fallback if LLM_MODEL not set)
OPENROUTER_DEFAULT_MODEL=openai/gpt-5.2

# Ollama host URL
OLLAMA_HOST=http://localhost:11434

# Ollama default model
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# Ollama embedding model
OLLAMA_EMBEDDING_MODEL=rjmalagon/gte-qwen2-1.5b-instruct-embed-f16

# ============================================================
# Storage Configuration
# ============================================================

# Path where cloned repositories are stored
# Default: ~/.pearl/repos
PEARL_REPOS_PATH=~/.pearl/repos

# ============================================================
# Production Configuration (only needed for prod)
# ============================================================

# Database URL (production only)
# DATABASE_URL=ecto://USER:PASS@HOST/DATABASE

# Secret key base (production only)
# Generate with: mix phx.gen.secret
# SECRET_KEY_BASE=

# Phoenix host (production only)
# PHX_HOST=example.com

# Database pool size (production only)
# POOL_SIZE=10

# Enable IPv6 (production only)
# ECTO_IPV6=false

# DNS cluster query (production only)
# DNS_CLUSTER_QUERY=
