Dockerfile
docker-compose.yml
.dockerignore

# Documentation and plans
docs/
*.md
LICENSE
CODEOWNERS

# Logs
logs/
pearl/logs/

# Tool config directories
.beagle/
.expert/
.serena/
.daydream/

# CI
.github
